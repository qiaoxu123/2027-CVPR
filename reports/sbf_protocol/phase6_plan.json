{
  "requires": [
    "data/public_eval_seen_v2/manifest.json"
  ],
  "environment": {
    "PYTHONPATH": ".",
    "HF_HUB_OFFLINE": "1",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "jobs": [
    {
      "name": "cache_landmark_vectors_train_seen",
      "command": [
